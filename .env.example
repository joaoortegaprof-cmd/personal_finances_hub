# ============================================================
# FinanceHub — Variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# O arquivo .env NUNCA deve ser versionado no git.
# ============================================================

# --- Identidade ---
APP_NAME=FinanceHub
APP_VERSION=0.1.0

# --- API interna (FastAPI + Uvicorn) ---
API_HOST=127.0.0.1
API_PORT=8765

# --- Banco de dados ---
# SQLite (dev):
DATABASE_URL=sqlite+aiosqlite:///./finance_hub.db
# PostgreSQL (prod): descomente e preencha:
# DATABASE_URL=postgresql+asyncpg://usuario:senha@localhost:5432/finance_hub

# --- Segurança ---
# Gere sua chave com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=TROQUE_ESTA_CHAVE_EM_PRODUCAO
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Cotações de mercado ---
MARKET_DATA_REFRESH_INTERVAL=300   # segundos (300 = 5 minutos)

# --- Localização ---
DEFAULT_CURRENCY=BRL
DEFAULT_LOCALE=pt_BR

# --- Depuração ---
DEBUG=true   # Defina false em produção
