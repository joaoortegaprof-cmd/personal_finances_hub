/* ================================================================
   FinanceHub — Tema escuro profissional
   Paleta de cores (ver frontend/components/colors.py para constantes):

   ESTRUTURA
     Fundo principal  : #1A1D2E  (COLOR_BG)
     Fundo elevado    : #222640  (COLOR_SURFACE)   cards, sidebar
     Fundo 2° nível   : #2A2E4A  (COLOR_SURFACE2)  inputs, hover
     Borda sutil      : #2E3250  (COLOR_BORDER)

   TEXTO
     Texto primário   : #E8EAED  (COLOR_NEUTRAL)
     Texto secundário : #C8CAD8  (COLOR_BALANCE)
     Texto apagado    : #8B90A7  (COLOR_MUTED)

   SEMÂNTICA
     Receitas/positivo: #00C896  (COLOR_ASSET / COLOR_INCOME)
     Despesas/passivos: #FF6B6B  (COLOR_EXPENSE)   — VERMELHO
     Dívidas/perigo   : #FF4D4D  (COLOR_PASSIVE / COLOR_DEBT)
     Investimentos    : #4A9EFF  (COLOR_INVESTMENT) — AZUL
     Aportes          : #378ADD  (COLOR_APORT)
     Aviso/laranja    : #FFB347  (COLOR_WARNING)

   CATEGORIAS
     Ações            : #00C896  (COLOR_STOCK)      verde
     FIIs             : #4A9EFF  (COLOR_FII)        azul
     ETFs             : #9B59B6  (COLOR_ETF)        roxo
     Tesouro          : #F39C12  (COLOR_TREASURY)   dourado
     Renda Fixa       : #1ABC9C  (COLOR_FIXED_INCOME)
     Cripto           : #E67E22  (COLOR_CRYPTO)     laranja
     Internacional    : #3498DB  (COLOR_INTERNATIONAL)
     Previdência      : #A78BFA  (COLOR_PENSION)    lilás
================================================================ */

/* ---- Reset base ------------------------------------------- */
QWidget {
    background-color: #1A1D2E;
    color: #E8EAED;
    font-family: "Inter", "Segoe UI", "Roboto", sans-serif;
    font-size: 11pt;
    border: none;
    outline: none;
}

/* QLabel herda background de QWidget — forçar transparente globalmente */
QLabel {
    background-color: transparent;
    color: #FFFFFF;
}

/* ---- Sidebar ----------------------------------------------- */
QFrame#sidebar {
    background-color: #222640;
    border-right: 1px solid #2E3250;
}

QWidget#sidebarLogo {
    background-color: transparent;
    padding: 20px 16px 12px 16px;
    border-bottom: 1px solid #2E3250;
}

QLabel#logoLabel {
    color: #E8EAED;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

/* Botões de navegação da sidebar */
QPushButton#navButton {
    background-color: transparent;
    color: #C8CAD8;
    text-align: left;
    padding: 12px 20px;
    margin: 2px 8px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    border: none;
}

QPushButton#navButton:hover {
    background-color: #262944;
    color: #FFFFFF;
}

/* Estado ativo: página atual selecionada */
QPushButton#navButton:checked {
    background-color: #2A2E4A;
    color: #00C896;
    border-left: 3px solid #00C896;
    padding-left: 17px; /* compensa a borda de 3px */
}

QPushButton#navButton:pressed {
    background-color: #2E3250;
}

QPushButton#navRefreshButton {
    background-color: transparent;
    color: #8B90A7;
    text-align: center;
    padding: 10px 20px;
    margin: 8px 8px 12px 8px;
    border-radius: 8px;
    border: 1px solid #2E3250;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#navRefreshButton:hover {
    background-color: #262944;
    color: #FFFFFF;
    border-color: #4A4E70;
}

QPushButton#navRefreshButton:pressed {
    background-color: #2E3250;
}

/* ---- Header ----------------------------------------------- */
QFrame#header {
    background-color: #222640;
    border-bottom: 1px solid #2E3250;
}

QLabel#headerTitle {
    color: #E8EAED;
    font-size: 18px;
    font-weight: 600;
}

/* ---- Títulos de página ------------------------------------ */
QLabel#page-title {
    color: #FFFFFF;
    font-size: 22px;
    font-weight: 700;
}

/* ---- Cards de resumo -------------------------------------- */
QFrame#summaryCard {
    background-color: #222640;
    border: 1px solid #2E3250;
    border-radius: 14px;
}

QFrame#summaryCard:hover {
    border-color: #4A9EFF;
}

QLabel#cardTitle {
    color: #8B90A7;
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.8px;
}

QLabel#cardValue {
    font-size: 26px;
    font-weight: 700;
}

/* ---- Seções e títulos ------------------------------------- */
QLabel#sectionTitle {
    color: #C8CAD8;
    font-size: 13px;
    font-weight: 600;
}

QLabel#loadingLabel {
    color: #8B90A7;
    font-size: 14px;
    padding: 32px;
}

/* ---- Placeholder do gráfico ------------------------------- */
QFrame#chartPlaceholder {
    background-color: #222640;
    border: 1px dashed #2E3250;
    border-radius: 12px;
}

QLabel#chartPlaceholderLabel {
    color: #8B90A7;
    font-size: 14px;
}

/* ---- Alertas ---------------------------------------------- */
QFrame#alertItem {
    background-color: #222640;
    border: 1px solid #2E3250;
    border-radius: 8px;
}

QFrame#alertItem:hover {
    background-color: #2A2E4A;
    border-color: #3D4466;
}

QLabel#alertTitle {
    color: #E8EAED;
    font-size: 13px;
    font-weight: 600;
}

QLabel#alertMessage {
    color: #8B90A7;
    font-size: 12px;
}

QLabel#noAlertsLabel {
    color: #8B90A7;
    font-size: 13px;
    padding: 16px 0;
}

/* ---- Dashboard scroll area -------------------------------- */
QScrollArea#dashboardScroll {
    background-color: #1A1D2E;
}

QWidget#dashboardContent {
    background-color: #1A1D2E;
}

/* ---- Tabelas (QTableWidget / QTableView) ------------------- */
QTableWidget,
QTableView {
    background-color: #222640;
    alternate-background-color: #252844;
    gridline-color: #2E3250;
    border: 1px solid #2E3250;
    border-radius: 8px;
    selection-background-color: #2A2E4A;
    selection-color: #E8EAED;
}

QTableWidget::item,
QTableView::item {
    padding: 8px 12px;
    border: none;
    font-size: 11px;
    color: #FFFFFF;
}

QTableWidget::item:selected,
QTableView::item:selected {
    background-color: #2E3250;
    color: #E8EAED;
}

QHeaderView::section {
    background-color: #2A2E4A;
    color: #C8CAD8;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    padding: 10px 12px;
    border: none;
    border-bottom: 1px solid #2E3250;
}

QHeaderView::section:hover {
    background-color: #2E3250;
    color: #E8EAED;
}

/* ---- Inputs e campos de texto ----------------------------- */
QLineEdit,
QTextEdit,
QPlainTextEdit {
    background-color: #2A2E4A;
    border: 1px solid #2E3250;
    border-radius: 8px;
    padding: 10px 14px;
    color: #FFFFFF;
    font-size: 14px;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border-color: #4A9EFF;
    background-color: #252844;
}

QLineEdit:disabled,
QTextEdit:disabled {
    color: #8B90A7;
    background-color: #151820;
}

QLineEdit::placeholder,
QLineEdit[placeholderText] {
    color: #C8CAD8;
}

/* ---- ComboBox (dropdowns) --------------------------------- */
QComboBox {
    background-color: #2A2E4A;
    border: 1px solid #2E3250;
    border-radius: 8px;
    padding: 8px 14px;
    color: #FFFFFF;
    font-size: 14px;
    min-width: 120px;
}

QComboBox:hover {
    border-color: #4A9EFF;
}

QComboBox:focus {
    border-color: #4A9EFF;
}

QComboBox::drop-down {
    border: none;
    width: 28px;
}

QComboBox QAbstractItemView {
    background-color: #222640;
    border: 1px solid #2E3250;
    border-radius: 8px;
    selection-background-color: #2A2E4A;
    selection-color: #E8EAED;
    padding: 4px;
}

/* ---- Botões de ação (secundário — padrão base) ------------ */
QPushButton {
    background-color: transparent;
    color: #C8CAD8;
    border: 2px solid #3D4166;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 11px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #2A2E4A;
    color: #FFFFFF;
}

QPushButton:pressed {
    background-color: #3D4466;
}

QPushButton:disabled {
    color: #4A5270;
    background-color: #222640;
    border-color: #252844;
}

/* Botão primário — ação principal (adicionar, salvar, confirmar) */
QPushButton[class="primary"] {
    background-color: #00C896;
    color: #0A0D14;
    border: 2px solid #00A87E;
    border-radius: 8px;
    padding: 10px 24px;
    font-size: 11px;
    font-weight: 700;
}

QPushButton[class="primary"]:hover {
    background-color: #00E5AC;
    border-color: #00C896;
}

QPushButton[class="primary"]:pressed {
    background-color: #009E78;
}

/* Botão de sucesso — confirmar / salvar */
QPushButton[class="success"] {
    background-color: #00C896;
    color: #0A0D14;
    border: 2px solid #00A87E;
    border-radius: 8px;
    padding: 10px 24px;
    font-size: 11px;
    font-weight: 700;
}

QPushButton[class="success"]:hover {
    background-color: #00E5AC;
    border-color: #00C896;
}

QPushButton[class="success"]:pressed {
    background-color: #009E78;
}

/* Botão de perigo — excluir */
QPushButton[class="danger"] {
    background-color: #FF4D4D;
    color: #FFFFFF;
    border: 2px solid #CC3D3D;
    font-weight: 600;
}

QPushButton[class="danger"]:hover {
    background-color: #FF6B6B;
}

QPushButton[class="danger"]:pressed {
    background-color: #CC3D3D;
}

/* ---- Scrollbars ------------------------------------------- */
QScrollBar:vertical {
    background-color: #222640;
    width: 8px;
    border-radius: 4px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #3D4466;
    border-radius: 4px;
    min-height: 32px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4A9EFF;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #222640;
    height: 8px;
    border-radius: 4px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #3D4466;
    border-radius: 4px;
    min-width: 32px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #4A9EFF;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ---- Tooltips --------------------------------------------- */
QToolTip {
    background-color: #2A2E4A;
    color: #E8EAED;
    border: 1px solid #2E3250;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

/* ---- Mensagens de status / labels especiais --------------- */
/* Semântica consistente com frontend/components/colors.py      */
QLabel[status="positive"] { color: #00C896; }  /* COLOR_ASSET  */
QLabel[status="negative"] { color: #FF6B6B; }  /* COLOR_EXPENSE */
QLabel[status="danger"]   { color: #FF4D4D; }  /* COLOR_PASSIVE */
QLabel[status="info"]     { color: #4A9EFF; }  /* COLOR_INVESTMENT */
QLabel[status="warning"]  { color: #FFB347; }  /* COLOR_WARNING */
QLabel[status="muted"]    { color: #8B90A7; }  /* COLOR_MUTED */

/* ---- Separadores ------------------------------------------ */
QFrame[frameShape="4"],   /* HLine */
QFrame[frameShape="5"] {  /* VLine */
    color: #2E3250;
    background-color: #2E3250;
}

/* ---- SpinBox (QSpinBox / QDoubleSpinBox) ------------------- */
QSpinBox,
QDoubleSpinBox {
    background-color: #2A2E4A;
    border: 1px solid #2E3250;
    border-radius: 8px;
    padding: 8px 10px;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 700;
    min-height: 40px;   /* aumentado de 32 → 40 px */
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #4A9EFF;
    background-color: #252844;
}

QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    background-color: #3D4466;
    border: none;
    width: 36px;        /* aumentado de 32 → 36 px */
    height: 20px;       /* aumentado de 16 → 20 px — zona de clique mais confortável */
    border-radius: 4px;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: #4A5270;
}

QSpinBox::up-button:pressed,
QSpinBox::down-button:pressed,
QDoubleSpinBox::up-button:pressed,
QDoubleSpinBox::down-button:pressed {
    background-color: #5A6280;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    width: 10px;        /* aumentado de 8 → 10 px */
    height: 10px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    width: 10px;        /* aumentado de 8 → 10 px */
    height: 10px;
}
